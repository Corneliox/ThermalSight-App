dist/
src/dist/
build/
bin/
out/
release/
analyzer.spec
*.spec

# --- Python & PyInstaller Caches ---
__pycache__/
*.py[cod]
*.class
*.pyc
*.pyd
*.pyo
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.installed.cfg
*.egg
backend/dist/
backend/build/

# --- Firebase Caches ---
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# --- IDE & Editor Configurations ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

