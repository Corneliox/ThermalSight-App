{
  "name": "thermalsight",
  "version": "1.6.6",
  "description": "Thermal Analysis Student Explorer",
  "author": "Aditya",
  "repository": "https://github.com/Aditya42069/ThermalSight-App",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.edu.thermalsight",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../backend/dist/analyzer",
        "to": "backend/analyzer",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/analyzer.py",
        "to": "backend/analyzer.py"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "minimumSystemVersion": "10.15.0",
      "category": "public.app-category.education",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "writeUpdateInfo": false,
      "format": "ULFO",
      "internetEnabled": false
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^8.0.12",
    "wait-on": "^7.0.1"
  }
}
